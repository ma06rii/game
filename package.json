{
  "name": "roz-game-contracts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "contract:artifact-check": "node scripts/check-class-artifact.mjs",
    "env:load": "varlock load --agent --show-all",
    "env:audit": "varlock audit --ignore target --ignore .snfoundry_cache",
    "env:scan": "varlock scan",
    "env:check": "node scripts/check-doppler.mjs && varlock run -- node scripts/check-contract-env.mjs"
  },
  "devDependencies": {
    "@varlock/doppler-plugin": "2.0.1",
    "varlock": "1.18.0"
  }
}
