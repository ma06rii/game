# @plugin(@varlock/doppler-plugin)

# @initDoppler(
#   project=roz-contract,
#   config=$DOPPLER_CONFIG,
#   serviceToken=$DOPPLER_TOKEN
# )
# @setValuesBulk(dopplerBulk())
# @defaultRequired=false
# @defaultSensitive=false

# ---

# Override with stg for demo Sepolia or prd for beta Mainnet.
DOPPLER_CONFIG=dev

# Uses DOPPLER_TOKEN from CI when present, otherwise the local Doppler login.
# This token is never stored in the roz-contract Doppler project.
# @type=dopplerServiceToken @sensitive @internal @required
DOPPLER_TOKEN=exec("doppler configure get token --plain")

# Common deployment context. The signing key remains exclusively in the local
# sncast account store; never add a private key or mnemonic to Doppler.
# @auditIgnore
STARKNET_NETWORK=
# @sensitive @auditIgnore
STARKNET_RPC_URL=
# Deployed address and declared class hashes for stg/prd initialization; the
# existing dev deployment retains its pinned values for backwards compatibility.
# @auditIgnore
GAME_ADDRESS=
# @auditIgnore
GAME_CLASS_HASH=
# @auditIgnore
FACET_CLASS_HASHES=
# @auditIgnore
SNCAST_ACCOUNT=
# @auditIgnore
DEPLOYER_ADDRESS=

# Shared Starknet dependencies. STRK uses Starknet's canonical token address.
# @auditIgnore
VRF_PROVIDER_ADDRESS=
# @auditIgnore
USDC_TOKEN_ADDRESS=
# @auditIgnore
STRK_TOKEN_ADDRESS=
# @auditIgnore
ROZ_TOKEN_ADDRESS=

# HelloStarknet deployment roles and governance.
# @auditIgnore
ROUND_KEEPER_ADDRESS=
# @auditIgnore
ADMIN_ADDRESS=
# @auditIgnore
PAUSER_ADDRESS=
# @auditIgnore
PAUSER_SNCAST_ACCOUNT=
# Separate admin signer for stg/prd initialization and governance.
# @auditIgnore
ADMIN_SNCAST_ACCOUNT=
# @auditIgnore
UPGRADE_DELAY=

# Zee Bucks (RZBX) constructor values. The deployed artifact retains the legacy
# `ROZToken` name for compatibility with existing declaration tooling.
# @auditIgnore
ROZ_RECIPIENT_ADDRESS=
# @auditIgnore
ROZ_OWNER_ADDRESS=

# TreasureGameStarterpack constructor values.
# @auditIgnore
STARTERPACK_OWNER_ADDRESS=
# @auditIgnore
ARCADE_REGISTRY_ADDRESS=

# Arcade registration (scripts/register-starterpacks.sh). The owner alias signs
# both the Arcade listings and set_pack_ids, so it must resolve locally to
# STARTERPACK_OWNER_ADDRESS. The receiver collects the USDC sales revenue.
# @auditIgnore
STARTERPACK_ADDRESS=
# @auditIgnore
STARTERPACK_OWNER_SNCAST_ACCOUNT=
# @auditIgnore
STARTERPACK_PAYMENT_RECEIVER=
