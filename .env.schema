# @plugin(@varlock/doppler-plugin)

# @initDoppler(
#   project=roz-contract,
#   config=$DOPPLER_CONFIG,
#   serviceToken=$DOPPLER_TOKEN
# )
# @setValuesBulk(dopplerBulk())
# @defaultRequired=false
# @defaultSensitive=false

# ---

# Only the shared development configuration is supported by these defaults.
DOPPLER_CONFIG=dev

# Uses DOPPLER_TOKEN from CI when present, otherwise the local Doppler login.
# This token is never stored in the roz-contract Doppler project.
# @type=dopplerServiceToken @sensitive @internal @required
DOPPLER_TOKEN=exec("doppler configure get token --plain")

# Common deployment context. The signing key remains exclusively in the local
# sncast account store; never add a private key or mnemonic to Doppler.
# @auditIgnore
STARKNET_NETWORK=
# @sensitive @auditIgnore
STARKNET_RPC_URL=
# @auditIgnore
SNCAST_ACCOUNT=
# @auditIgnore
DEPLOYER_ADDRESS=

# Shared Starknet dependencies. STRK uses Starknet's canonical token address.
# @auditIgnore
VRF_PROVIDER_ADDRESS=
# @auditIgnore
USDC_TOKEN_ADDRESS=
# @auditIgnore
STRK_TOKEN_ADDRESS=
# @auditIgnore
ROZ_TOKEN_ADDRESS=

# HelloStarknet deployment roles and governance.
# @auditIgnore
ROUND_KEEPER_ADDRESS=
# @auditIgnore
ADMIN_ADDRESS=
# @auditIgnore
PAUSER_ADDRESS=
# @auditIgnore
PAUSER_SNCAST_ACCOUNT=
# @auditIgnore
UPGRADE_DELAY=

# ROZToken constructor values.
# @auditIgnore
ROZ_RECIPIENT_ADDRESS=
# @auditIgnore
ROZ_OWNER_ADDRESS=

# TreasureGameStarterpack constructor values.
# @auditIgnore
STARTERPACK_OWNER_ADDRESS=
# @auditIgnore
ARCADE_REGISTRY_ADDRESS=
